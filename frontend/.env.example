# Vite client-facing API base.
# Keep this at /api for browser-based local dev.
VITE_API_BASE_URL=/api

# Browser navigation targets for proxy/IdP-owned auth.
# The frontend does not store OAuth tokens; it only sends users to these URLs
# when the API reports that authentication is required.
VITE_AUTH_SIGN_IN_URL=/oauth2/start?rd={returnTo}
VITE_AUTH_SIGN_OUT_URL=/oauth2/sign_out?rd={returnTo}

# Vite dev-server proxy target.
# The current backend serves root-mounted routes, so the proxy rewrites
# /api/* -> /* as the supported local-demo setup.
MTG_FRONTEND_PROXY_TARGET=http://127.0.0.1:8000
